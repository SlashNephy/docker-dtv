+    /**
+     * updateAll を多重起動させずに実行する
+     *
+     * updateAll は program テーブルの全件削除と全件挿入を単一トランザクションで行うため、
+     * 多重起動すると互いに行ロックを奪い合い、innodb_lock_wait_timeout まで待ってから
+     * ロールバックする。呼び出し元はいずれも完了を待たない周期実行なので、
+     * ガードが無いと一度崩れたきり永久に回復しない。
+     *
+     * STREAM_STARTED は event stream に接続するたびに発火する。
+     * 接続が即座に切れて再接続を繰り返す状況では発火が高頻度になるため、
+     * 最短でも epgUpdateIntervalTime の間隔を空ける。
+     *
+     * @return Promise<boolean> 実際に updateAll を実行したら true
+     */
+    private async updateAllExclusively(): Promise<boolean> {
+        const now = new Date().getTime();
+
+        if (this.isUpdatingAll === true) {
+            this.log.system.warn('updateAll is already running. skipped.');
+
+            return false;
+        }
+
+        const minInterval = this.config.epgUpdateIntervalTime * 60 * 1000;
+        if (this.lastUpdateAllStartedTime + minInterval > now) {
+            this.log.system.warn('updateAll is called too frequently. skipped.');
+
+            return false;
+        }
+
+        this.isUpdatingAll = true;
+        this.lastUpdateAllStartedTime = now;
+        try {
+            await this.updateManage.updateAll();
+        } finally {
+            this.isUpdatingAll = false;
+        }
+
+        return true;
+    }
